# These variables must be exported before launch; the application does not auto-load this file.
# Leave passwords unset to generate random local accounts. Use at least 12 characters if setting them.
# GLUCOTWIN_ADMIN_PASSWORD=
# GLUCOTWIN_REVIEWER_PASSWORD=
# GLUCOTWIN_DB_PATH=/absolute/private/path/clinic.sqlite3
# GLUCOTWIN_CREDENTIALS_PATH=/absolute/private/path/clinic-credentials.json
GLUCOTWIN_API_PORT=8765
GLUCOTWIN_UI_PORT=5173
GLUCOTWIN_ENV=research
# SQLite is the default. A PostgreSQL research environment uses the explicit migrated schema:
# GLUCOTWIN_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/glucotwin_research
# GLUCOTWIN_KEY_PATH=/absolute/private/path/encryption.key
# GLUCOTWIN_ENCRYPTION_KEY=   # Fernet key; keep separate from encrypted backups
# GLUCOTWIN_COOKIE_SECURE=true  # Only with HTTPS, false on local loopback HTTP
# GLUCOTWIN_DISABLE_WORKER=1   # API-only mode when running backend.worker separately
# GLUCOTWIN_CLINICIAN_PASSWORD=
# GLUCOTWIN_COORDINATOR_PASSWORD=
# GLUCOTWIN_PATIENT_PASSWORD=

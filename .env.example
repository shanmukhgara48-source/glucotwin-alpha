# These variables must be exported before launch; the application does not auto-load this file.
# Leave passwords unset to generate random local accounts. Use at least 12 characters if setting them.
# GLUCOTWIN_ADMIN_PASSWORD=
# GLUCOTWIN_REVIEWER_PASSWORD=
# GLUCOTWIN_DB_PATH=/absolute/private/path/clinic.sqlite3
# GLUCOTWIN_CREDENTIALS_PATH=/absolute/private/path/clinic-credentials.json
GLUCOTWIN_API_PORT=8765
GLUCOTWIN_UI_PORT=5173
